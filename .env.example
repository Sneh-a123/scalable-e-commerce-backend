# ==========================================
# NEXORA PLATFORM ENVIRONMENT CONFIGURATION
# ==========================================

# Backend Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database & Caching
MONGO_URI=mongodb://127.0.0.1:27017/nexora_db
REDIS_URL=redis://127.0.0.1:6379

# JWT Secrets & Expiry
JWT_SECRET=nexora_super_secret_jwt_key_2026_genz_saas
JWT_REFRESH_SECRET=nexora_refresh_secret_jwt_key_2026_future
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Default Initial Administrator
ADMIN_EMAIL=admin@nexora.com
ADMIN_PASSWORD=Admin@12345

# Sandbox Payment Credentials
RAZORPAY_KEY_ID=rzp_test_nexora_mock_key
RAZORPAY_KEY_SECRET=nexora_rzp_mock_secret_key_999

# Optional AI & Developer APIs
GEMINI_API_KEY=
GITHUB_TOKEN=
